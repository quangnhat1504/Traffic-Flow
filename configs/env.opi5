# ==========================================
# TrafficFlow Edge Cloud Environment (Orange Pi 5 - RK3588 NPU)
# Target: Compute Node (Cloud)
# ==========================================

APP_ENV=production

# Local Database on Edge (SQLite WAL mode - zero remote dependency)
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB_NAME=trafficflow
MONGODB_LOCAL_FALLBACK=true
MONGODB_TLS=false
MONGODB_SERVER_SELECTION_TIMEOUT_MS=500
MONGODB_CONNECT_TIMEOUT_MS=500
LOCAL_DB_ENGINE=sqlite
SQLITE_DB_PATH=storage/trafficflow_edge.sqlite
LOCAL_DB_PATH=storage/local_db.json

# Local Redis for Task Queues
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
CELERY_QUEUE_NAME=trafficflow_gpu_queue

# Network & CORS (Allow Client display machine to access all endpoints)
CALLBACK_HOST=http://100.115.216.86:8000
CALLBACK_TOKEN=
CORS_ORIGINS=*

# Static Assets & Storage Mock
R2_ACCOUNT_ID=placeholder_account_id
R2_ACCESS_KEY_ID=placeholder_access_key
R2_SECRET_ACCESS_KEY=placeholder_secret_key
R2_BUCKET_NAME=trafficflow
R2_PUBLIC_URL=http://100.115.216.86:8000/static
STORAGE_DIR=storage

# Rockchip RK3588 Tri-core NPU Model Configuration
AI_LOCAL=true
AI_MODEL_DIR=models
AI_MODEL_PATH=models/rknn/my_finetuned_yolov8_416_fp16.rknn
AI_DEVICE=0
AI_IMGSZ=416
AI_HALF=false
AI_CLASS_IDS=0,1,2,3
AI_CONFIDENCE=0.20
AI_FRAME_SKIP=1
AI_RESIZE_DIM=416
AI_ENABLE_STABILIZATION=false

# Live Stream Ingestion & Session Management
LIVE_BLOCK_PRIVATE_HOSTS=false
LIVE_PREVIEW_TIMEOUT_SECONDS=20
LIVE_SOURCE_TTL_SECONDS=3600
LIVE_SESSION_RETENTION_SECONDS=600
LIVE_MAX_SESSIONS=4

# Geometry & ROI
ROI_MODE=crop_rect
MAX_FILE_SIZE_MB=2048
RETENTION_DAYS=7
